# Copy this file to .env for local development.
#
# This service does NOT manage Urja Meter Ops login or sessions — see
# README.md "Authentication" for why. The variables below are only for
# local/manual testing convenience:

# Port this API listens on.
PORT=3000

# Base URL of the upstream Urja Meter Ops portal.
UPSTREAM_BASE_URL=https://urja-ops.flockenergy.tech

# OPTIONAL, local manual smoke-testing only (see test/manual-smoke-test.js).
# Never used by the automated test suite, never read by the running API
# server itself, and never committed. Paste a session token here only if you
# want to run the manual smoke-test script against the live portal yourself.
URJA_SESSION_TOKEN_FOR_SMOKE_TEST=
